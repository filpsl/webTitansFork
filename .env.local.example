#CAMADA IMPRESSORA
# NUNCA preencha valores reais neste arquivo — ele é commitado.
# Copie para .env.local (já está no .gitignore) e edite lá:
#   cp .env.local.example .env.local
#
# Em produção (Vercel), estas variáveis vivem em
# Project Settings → Environment Variables, não neste arquivo.

# Cliente (NEXT_PUBLIC_*: empacotados no bundle do navegador).
# A anon key + URL pública é OK expor — a RLS do Supabase protege os dados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Link de convite do grupo de ajuda dos CLIENTES no Telegram (grupo separado do
# chat de notificações da equipe, TELEGRAM_CHAT_ID). Opcional — sem ela o botão
# do Telegram não aparece no kiosk. Convite público por natureza, então pode ser
# NEXT_PUBLIC_ (qualquer um com o QR entra no grupo).
NEXT_PUBLIC_TELEGRAM_HELP_INVITE_URL=

# Servidor (consumidas apenas pelos Route Handlers / libs em src/lib/server/*).
# REGRA DE SEGURANÇA: segredos de servidor NUNCA levam o prefixo NEXT_PUBLIC_ —
# o prefixo os empacotaria no bundle do cliente, vazando-os.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Notificação dos chamados de ajuda do kiosk (/api/kiosk/help) via Telegram.
# Opcionais: sem elas os chamados só ficam registrados na tabela chamados_ajuda.
# Crie um bot com o @BotFather (token) e adicione-o ao grupo/canal da equipe;
# TELEGRAM_CHAT_ID é o id do chat (ex.: -1001234567890 para grupos).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook de ENTRADA do bot do Telegram (/api/telegram/webhook) — comandos
# administrativos de reimpressão (/reimprimir, /gerar_codigo).
# TELEGRAM_ADMIN_IDS: allowlist de Telegram user IDs autorizados a usar os
# comandos, separados por vírgula (ex.: 111111111,222222222). Autorização é
# SEMPRE por essa lista, nunca por "estar no grupo" — pegue o próprio ID em
# conversa com @userinfobot.
# TELEGRAM_WEBHOOK_SECRET: o secret_token configurado no setWebhook; o
# webhook rejeita qualquer request sem o header
# X-Telegram-Bot-Api-Secret-Token correspondente. Gere com, por exemplo,
# `openssl rand -hex 32`.
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=

# URL canônica de produção, usada como notification_url do webhook do Mercado Pago.
# Fixar o domínio evita que um deploy de preview efêmero (*.vercel.app) registre
# uma notification_url que o Mercado Pago não conseguiria reconfirmar.
# Em dev/Docker local pode ficar vazia (o handler cai nos headers x-forwarded-*).
PUBLIC_BASE_URL=https://www.roboticstitans.com.br

#CAMADA TITANS

# Supabase do projeto TITANS — mesmo projeto do DATABASE_URL/DIRECT_URL abaixo,
# mas usado só para o Storage (bucket `arquivos-3d`): a publishable é usada
# pelo navegador pra subir o arquivo (.stl/.step + fotos; a policy do bucket
# restringe a INSERT), a secret é usada pela API pra ler os arquivos de volta
# e anexá-los no e-mail de aviso da equipe. As tabelas (ex.: pedidos_3d) são
# acessadas via Prisma, não por aqui. Pegue em Project Settings → API do
# projeto TITANS. Chaves no formato novo do Supabase
# (sb_publishable_/sb_secret_...), não JWT.
NEXT_PUBLIC_SUPABASE_TITANS_URL=
NEXT_PUBLIC_SUPABASE_TITANS_PUBLISHABLE_KEY=
SUPABASE_TITANS_URL=
SUPABASE_TITANS_SECRET_KEY=

# E-mail da equipe que recebe o aviso de novo pedido do serviço de impressão
# 3D (com os arquivos anexados, quando não excedem o limite do Resend).
# Opcional: sem ela, o e-mail simplesmente não é enviado.
PEDIDOS_3D_EMAIL_EQUIPE=

# E-mail da equipe que recebe o feedback anônimo enviado em /feedback
# (POST /api/feedback). Obrigatória — sem ela a rota recusa o envio (500),
# já que aqui o e-mail É a única forma de o feedback chegar em algum lugar
# (não tem persistência em banco).
FEEDBACK_EMAIL_EQUIPE=

# DATABASE_URL: connection string do pooler do Supabase (PgBouncer, porta 6543)
# usada em runtime pela aplicação.
DATABASE_URL="postgresql://<usuario>:<senha>@<host>:<porta>/<banco-de-dados>?schema=public"

# DIRECT_URL: connection string do pooler do Supabase em modo sessão (porta
# 5432, mesmo host do pooler), usada só pelo Prisma Migrate/CLI (prisma7.config.ts).
# Em modo transação (porta 6543) o Migrate trava tentando criar/derrubar o
# shadow database, porque esse modo não sustenta operações de sessão.
DIRECT_URL="postgresql://<usuario>:<senha>@<host>:5432/<banco-de-dados>?schema=public"

# AUTH_SECRET: chave usada pelo NextAuth (Auth.js) pra assinar cookies/tokens.
# Gere uma com `npx auth secret` (cria/atualiza esta variável automaticamente)
# ou `openssl rand -base64 33`.
AUTH_SECRET=""

# Usadas só uma vez pelo `npx prisma db seed` pra criar/atualizar o usuário
# master (role MESTRE). Pode remover do .env.local depois do primeiro seed.
MASTER_EMAIL=""
MASTER_PASSWORD=""
MASTER_NOME=""

# RESEND_API_KEY: crie uma conta em resend.com e gere uma API key — usada pra
# mandar o e-mail de "defina sua senha" quando o MESTRE adiciona um membro
# (painel Gerenciar Membros). Sem essa variável, o membro é cadastrado
# normalmente mas o e-mail não é enviado (dá pra reenviar depois no painel).
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: NÃO é uma chave — é só o endereço remetente. Opcional:
# sem domínio próprio verificado no Resend, deixe vazio que usa o remetente
# de teste deles (onboarding@resend.dev) — mas repare que, nesse modo sandbox,
# o Resend só entrega pro e-mail do dono da conta, recusando qualquer outro
# destinatário (erro 403 "You can only send testing emails to your own email
# address"). Pra mandar convite pra membros de verdade, verifique um domínio
# em resend.com/domains e preencha essa variável com um remetente desse
# domínio, opcionalmente com nome de exibição
# (ex.: "Team Titans <contato@roboticstitans.com.br>").
RESEND_FROM_EMAIL=""